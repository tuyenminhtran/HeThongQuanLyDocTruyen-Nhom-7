# Mau bien moi truong cho StoryReader.Api (Production / Staging)
# Khong commit gia tri that len Git.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5066

# Chuoi ket noi PostgreSQL & Redis
ConnectionStrings__Default=Host=postgres;Port=5432;Database=storyreader;Username=storynest;Password=REPLACE_WITH_STRONG_DB_PASSWORD
ConnectionStrings__Redis=redis:6379

# Khoa ky JWT (toi thieu 32 ky tu ngau nhien entropy cao, khong chua chuoi 'DevOnly' hay 'CHANGE_ME')
Jwt__Issuer=StoryReaderApi
Jwt__Audience=StoryReaderClients
Jwt__Key=REPLACE_WITH_64_CHAR_CRYPTO_RANDOM_JWT_SECRET_KEY
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30

# Bao mat Webhook thanh toan (toi thieu 16 ky tu)
Payments__EnableDevSimulation=false
Payments__CallbackSecret=REPLACE_WITH_RANDOM_WEBHOOK_SECRET_MIN_16_CHARS
Payments__VnPay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Payments__VnPay__ReturnUrl=https://your-domain.example/pricing
Payments__VnPay__TmnCode=YOUR_VNPAY_TMN_CODE
Payments__VnPay__HashSecret=YOUR_VNPAY_HASH_SECRET

# Danh sach domain Frontend duoc phep CORS
Cors__AllowedOrigins__0=https://your-domain.example
